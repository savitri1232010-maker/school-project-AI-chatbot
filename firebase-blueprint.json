{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Permanent Quickio AI user account created via Google Login.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Immutable Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name from Google profile",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email",
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar photo URL",
          "maxLength": 1024
        },
        "responseStyle": {
          "type": "string",
          "enum": ["concise", "balanced", "detailed"],
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account update server timestamp"
        }
      },
      "required": ["uid", "displayName", "email", "responseStyle", "createdAt", "updatedAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Saved conversation thread belonging to a specific user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the owning user",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Conversation title shown in the dropdown history",
          "maxLength": 140
        },
        "featureId": {
          "type": "string",
          "description": "Feature module identifier",
          "maxLength": 64
        },
        "messagesSummary": {
          "type": "string",
          "description": "Serialized conversation messages up to 80KB",
          "maxLength": 80000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last message server timestamp"
        }
      },
      "required": ["ownerId", "title", "featureId", "messagesSummary", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account document accessible strictly by the account owner."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "User chat history threads accessible strictly by the owning user."
    }
  }
}
